<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 001: Wallets Table -->
    <changeSet id="001-create-wallets" author="maito-wallet-architect">
        <comment>Customer financial wallet and loyalty coin balance ledger</comment>
        <createTable tableName="wallets">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_profile_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_wallets_customer_profile" references="tenant_user_profiles(id)" deleteCascade="true" unique="true" uniqueConstraintName="uk_wallets_customer_profile_id"/>
            </column>
            <column name="balance" type="NUMERIC(12,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(8)" defaultValue="INR">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE wallets ADD CONSTRAINT chk_wallets_balance_non_negative CHECK (balance >= 0);
        </sql>

        <createIndex tableName="wallets" indexName="idx_wallets_customer_profile">
            <column name="customer_profile_id"/>
        </createIndex>
    </changeSet>

    <!-- 002: Wallet Transactions Table -->
    <changeSet id="002-create-wallet-transactions" author="maito-wallet-architect">
        <comment>Double-entry transactional audit ledger for wallet credit/debit movements</comment>
        <createTable tableName="wallet_transactions">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="wallet_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_wallet_transactions_wallet" references="wallets(id)" deleteCascade="true"/>
            </column>
            <column name="transaction_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="NUMERIC(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="balance_after" type="NUMERIC(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="reference_id" type="VARCHAR(128)"/>
            <column name="description" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE wallet_transactions ADD CONSTRAINT chk_wallet_transactions_amount_positive CHECK (amount > 0);
        </sql>

        <createIndex tableName="wallet_transactions" indexName="idx_wallet_tx_wallet_id">
            <column name="wallet_id"/>
        </createIndex>
        <createIndex tableName="wallet_transactions" indexName="idx_wallet_tx_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!-- 003: Payment Transactions Table -->
    <changeSet id="003-create-payment-transactions" author="maito-payment-architect">
        <comment>Payment gateway transaction settlement and webhook ledger</comment>
        <createTable tableName="payment_transactions">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_payment_transactions_order" references="orders(id)" deleteCascade="true"/>
            </column>
            <column name="gateway_provider" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="gateway_order_id" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="gateway_payment_id" type="VARCHAR(128)"/>
            <column name="gateway_signature" type="VARCHAR(256)"/>
            <column name="amount" type="NUMERIC(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency_code" type="VARCHAR(8)" defaultValue="INR">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)" defaultValue="INITIATED">
                <constraints nullable="false"/>
            </column>
            <column name="raw_response" type="JSONB" defaultValueComputed="'{}'::jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="payment_transactions" indexName="idx_payment_tx_order_id">
            <column name="order_id"/>
        </createIndex>
        <createIndex tableName="payment_transactions" indexName="idx_payment_tx_gateway_order_id">
            <column name="gateway_order_id"/>
        </createIndex>
    </changeSet>

    <!-- 004: Add coins_redeemed to orders table -->
    <changeSet id="004-add-coins-redeemed-to-orders" author="maito-order-architect">
        <comment>Persist loyalty coins redeemed during checkout against the order</comment>
        <addColumn tableName="orders">
            <column name="coins_redeemed" type="NUMERIC(12,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
