{
  "info": {
    "_postman_id": "maito-system-api-v1",
    "name": "Maito E-Commerce Monolith API - System & Diagnostics",
    "description": "Baseline API collection for Maito Backend Monolith Platform. Includes health diagnostics, help guidance, and OpenAPI spec endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & System Diagnostics",
      "item": [
        {
          "name": "System Health Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "description": "Returns operational status, service identifier, version, timestamp, and environment profile."
          }
        },
        {
          "name": "System Help & API Guidance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/help",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "help"
              ]
            },
            "description": "Returns interactive Swagger UI and OpenAPI documentation links."
          }
        },
        {
          "name": "OpenAPI v3 Specification",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v3/api-docs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v3",
                "api-docs"
              ]
            },
            "description": "Raw JSON OpenAPI 3.0 specification."
          }
        }
      ]
    }
  ]
}