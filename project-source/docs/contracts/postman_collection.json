{
  "info": {
    "name": "Maito Multi-Tenant Platform Core API",
    "description": "Enterprise Control Plane, Dynamic Tenant Routing, Connection Telemetry, and Decommissioning",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0-phase1-core"
  },
  "item": [
    {
      "name": "Health & System",
      "item": [
        {
          "name": "System Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Health status is UP\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.status).to.eql(\"UP\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Actuator Tenant Pool Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/actuator/tenants",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "actuator",
                "tenants"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains tenantPools telemetry\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"tenantPools\");",
                  "    pm.expect(jsonData).to.have.property(\"activeTenants\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Platform Control Plane",
      "item": [
        {
          "name": "Provision Isolated Tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"mito_crunch\",\n  \"tenantSlug\": \"mitocrunch\",\n  \"legalName\": \"Mito Crunch Superfoods Pvt Ltd\",\n  \"primaryDomain\": \"store.mitocrunch.com\",\n  \"countryCode\": \"IN\",\n  \"currencyCode\": \"INR\",\n  \"initialAdminEmail\": \"admin@mitocrunch.com\",\n  \"initialConfig\": {\n    \"tier\": \"ENTERPRISE\",\n    \"max_pool_size\": 20\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/internal/platform/tenants",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "internal",
                "platform",
                "tenants"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test(\"Envelope success is true\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.tenantId).to.eql(\"mito_crunch\");",
                  "    pm.expect(jsonData.data.status).to.eql(\"ACTIVE\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Tenant Metadata",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/internal/platform/tenants/mito_crunch",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "internal",
                "platform",
                "tenants",
                "mito_crunch"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns correct tenant metadata\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.tenantId).to.eql(\"mito_crunch\");",
                  "    pm.expect(jsonData.data.tenantSlug).to.eql(\"mitocrunch\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Tenant Pool Telemetry",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/internal/platform/tenants/telemetry",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "internal",
                "platform",
                "tenants",
                "telemetry"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Pool telemetry returns valid list\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Decommission Tenant",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/internal/platform/tenants/mito_crunch",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "internal",
                "platform",
                "tenants",
                "mito_crunch"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Tenant state transitioned to DECOMMISSIONED\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.accountState).to.eql(\"DECOMMISSIONED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Dynamic Routing & Security Gates",
      "item": [
        {
          "name": "Route via Header (Active Tenant)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "mito_crunch"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Route via Host Header (Custom Domain)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Host",
                "value": "store.mitocrunch.com"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            }
          }
        },
        {
          "name": "Security Gate: Suspended Tenant (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "suspended_tenant"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Error code is TENANT_SUSPENDED\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(false);",
                  "    pm.expect(jsonData.error.code).to.eql(\"TENANT_SUSPENDED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Security Gate: Unknown Tenant (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-ID",
                "value": "unknown_tenant"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"Error code is TENANT_NOT_FOUND\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(false);",
                  "    pm.expect(jsonData.error.code).to.eql(\"TENANT_NOT_FOUND\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    }
  ]
}