# =============================================================================
# Maito Monolith - Production Environment Variables Template
# =============================================================================

# Application Runtime Profile
SPRING_PROFILES_ACTIVE=prod
TZ=UTC

# PostgreSQL 16 Multi-Tenant Database
POSTGRES_DB=maito_db
POSTGRES_USER=maito_user
POSTGRES_PASSWORD=maito_secure_db_password_10yr
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/maito_db

# Redis 7 Caching & Session Storage
REDIS_PASSWORD=maito_secure_redis_password_10yr
REDIS_PORT=6379
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=maito_secure_redis_password_10yr

# Gateway & Security
MAITO_RATE_LIMITING_ENABLED=true
JWT_SECRET=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f
JWT_EXPIRATION_MS=86400000

# Server Ports & Proxies
SERVER_PORT=8080
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443